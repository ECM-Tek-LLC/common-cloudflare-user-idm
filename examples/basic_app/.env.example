# ---------------------------------------------------------------------------
# Local development: no Cloudflare tunnel, no tokens.
#
# The bypass treats every request as CF_ACCESS_DEV_USER_EMAIL. The app refuses to
# start with these settings if APP_ENV is prod/production/stage/staging.
# ---------------------------------------------------------------------------
APP_ENV=development
CF_ACCESS_DEV_MODE=true
CF_ACCESS_DEV_USER_EMAIL=dev@localhost
CF_ACCESS_DEV_USER_NAME=Local Developer

# Handy while wiring things up; exposes GET /auth/debug.
CF_ACCESS_ENABLE_DEBUG_ENDPOINT=true

# ---------------------------------------------------------------------------
# Deployed behind Cloudflare Access: delete everything above and use this.
#
# CF_ACCESS_TEAM_DOMAIN  Zero Trust dashboard -> Settings -> Custom Pages -> team domain
#                        (the 'acme' in acme.cloudflareaccess.com)
# CF_ACCESS_AUDIENCE     Access -> Applications -> your app -> Overview -> Application Audience
#                        (AUD) Tag. Comma-separated if the origin sits behind several apps.
# ---------------------------------------------------------------------------
# APP_ENV=production
# CF_ACCESS_TEAM_DOMAIN=acme
# CF_ACCESS_AUDIENCE=0a1b2c3d4e5f60718293a4b5c6d7e8f90a1b2c3d4e5f60718293a4b5c6d7e8f9

# Optional: fetch display name, groups and IdP details from Cloudflare's identity
# endpoint. Costs one cached HTTP call per session; browser traffic only.
# CF_ACCESS_FETCH_IDENTITY=true

# Optional: refuse Cloudflare Access service tokens outright.
# CF_ACCESS_ALLOW_SERVICE_TOKENS=false
